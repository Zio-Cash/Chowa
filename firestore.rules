rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni utente ha un documento col proprio UID.
    // - Scrittura: solo il proprietario.
    // - Lettura: il proprietario oppure chi è stato autorizzato (nell'array `viewers`).
    match /states/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         (resource.data.viewers is list && request.auth.uid in resource.data.viewers));
    }
  }
}
